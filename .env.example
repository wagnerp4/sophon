# Copy to .env and fill in. Never commit real secrets.

# Windows TUI deploy tree (WSL rsync target + WT profile startingDirectory)
# SOPHON_WINDOWS_ROOT=C:\Software\Python\NLP\Personal\sophon

HF_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434

# Chat backends: auto = Ollama if reachable, else LM Studio, else HF presets.
# Cloud APIs are opt-in via /backend openai|anthropic|google (never selected by auto).
SOPHON_CHAT_BACKEND=auto
SOPHON_LM_STUDIO_HOST=http://127.0.0.1:1234/v1
# SOPHON_LM_STUDIO_API_KEY=
# SOPHON_LM_STUDIO_TIMEOUT_S=600

# Managed chat APIs (Nexus harness tools work on these the same as LM Studio).
# Windows TUI reads the deploy-tree .env (SOPHON_WINDOWS_ROOT), not the WSL checkout.
# deploy-windows.sh merges SOPHON_*_API_KEY from the WSL .env into that file.
# SOPHON_OPENAI_API_KEY=
# SOPHON_OPENAI_BASE_URL=https://api.openai.com/v1
# SOPHON_ANTHROPIC_API_KEY=
# Gemini Developer API is NOT Gmail/Drive OAuth (those stay SOPHON_GOOGLE_*).
# SOPHON_GEMINI_API_KEY=

# TTS (default: Pipecat Kokoro local). Install: uv sync --extra tts
SOPHON_TTS_BACKEND=pipecat
SOPHON_TTS_SPEAKER=am_adam
SOPHON_TTS_LANGUAGE=English
# SOPHON_TTS_SPEED=1.25
# SOPHON_TTS_TOOL=1
# SOPHON_TTS_BACKEND=hf_qwen_custom_voice
# SOPHON_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# SST / mic (Qwen ASR). Install: uv sync --extra sst
# SOPHON_SST=1
# SOPHON_SST_TOOL=1
# SOPHON_SST_BACKEND=hf_qwen
# SOPHON_SST_MODEL=Qwen/Qwen3-ASR-0.6B
# SOPHON_SST_LANGUAGE=English
# SOPHON_SST_MAX_S=120
# SOPHON_SST_VAD_RMS=0.012
# SOPHON_SST_MIC=

# Obsidian vault tools (LM Studio chat tool loop via Local REST API plugin)
# SOPHON_OBSIDIAN_TOOLS=1
# SOPHON_OBSIDIAN_API_URL=https://127.0.0.1:27124
# SOPHON_OBSIDIAN_API_KEY=

# Zotero explorer + chat tools. Local API if Zotero is running, else sqlite.
# Tools default on when the library is reachable. Set 0 to disable.
# SOPHON_ZOTERO_TOOLS=1
# SOPHON_ZOTERO_API_URL=http://127.0.0.1:23119/api
# SOPHON_ZOTERO_DB_PATH=C:\Users\Phili\Zotero\zotero.sqlite

# Overleaf Premium Git (editor tree + chat list/read). Default off until configured.
# SOPHON_OVERLEAF_TOOLS=1
# SOPHON_OVERLEAF_GIT_TOKEN=olp_...
# SOPHON_OVERLEAF_PROJECT_ID=
# SOPHON_OVERLEAF_PROJECT_IDS=id1,id2
# Optional aliases: data/overleaf/projects.json  {"alias": "projectId"}

# Memory layer (on by default). Set SOPHON_MEMORY_DB=0 to disable. See docs/direction/memory.md.
SOPHON_MEMORY_DB=data/memory/memory.db
# SOPHON_MEMORY_SESSION=
# SOPHON_MEMORY_USER=
SOPHON_MEMORY_RECALL_TURNS=6
# SOPHON_MEMORY_DIR=.sophon/memory
SOPHON_MEMORY_BUDGET_CHARS=4000
SOPHON_MEMORY_TOOLS=1

# Skills (Agent Skills SKILL.md). On by default. Set SOPHON_SKILLS=0 to disable.
# SOPHON_SKILLS=1
# SOPHON_SKILLS_DIRS=
# SOPHON_SKILLS_CATALOG_CHARS=1500
SOPHON_SKILL_TOOLS=1

# In-process subagents (DSH spawn+fork). Default on. Inherit the parent model. maxDepth=1, maxActive=1.
SOPHON_SUBAGENT_TOOLS=1
SOPHON_SUBAGENT_MAX_DEPTH=1
SOPHON_SUBAGENT_MAX_ACTIVE=1

# /energy local|api. Daily cap is USD. Ask-and-hold stops after the timeout.
# SOPHON_ENERGY=local
# SOPHON_ENERGY_DAILY_USD=5
# SOPHON_ENERGY_MONTHLY_USD=40
# SOPHON_ENERGY_RPM=60
# SOPHON_ENERGY_ON_LIMIT=ask
# SOPHON_ENERGY_ASK_TIMEOUT_S=60
# SOPHON_COMPACT=1
# SOPHON_COMPACT_KEEP_TURNS=6
# SOPHON_COMPACT_RATIO=0.70
# SOPHON_MCP=1
# SOPHON_INJECTED_TOOLS=

# Local shell tools in chat (with vault tools when both env flags are on). PowerShell on Windows.
# SOPHON_SHELL_TOOLS=1
# GitHub account tools (create/list). Search stays web_search source=github.
# SOPHON_GITHUB_TOKEN=
# SOPHON_GITHUB_TOOLS=1
# SOPHON_SHELL_TIMEOUT_S=60
# Tool-loop rounds (default unlimited). Set 6 to restore the old cap. Chat: /tool-rounds N | /unlimited
# SOPHON_TOOL_MAX_ROUNDS=unlimited

# Dashboard layout (2-col grid; system/markets/news/twitch span full width when registered)
SOPHON_DASHBOARD_TILES=host,weather,services,storage,system,markets,news,polymarket,twitch
# Optional: semicolon-separated roots for storage tile filetype sample (default: repo root)
# SOPHON_SYSTEM_FILETYPE_ROOTS=C:\Software\Python\NLP\Personal\sophon;H:\data

# Weather (Open-Meteo). Leave empty for IP auto-detect.
# SOPHON_WEATHER_QUERY=Munich
# SOPHON_WEATHER_LAT=48.137
# SOPHON_WEATHER_LON=11.576
# SOPHON_WEATHER_TZ=Europe/Berlin
# SOPHON_WEATHER_AQI=1

# Markets (crypto + metals + equities/ETFs)
SOPHON_CRYPTO_SYMBOLS=BTC,ETH,SOL
SOPHON_CRYPTO_PROVIDER=kraken
SOPHON_METALS_SYMBOLS=GC=F,SI=F
SOPHON_QUOTES_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,SPY,QQQ
SOPHON_QUOTES_PROVIDER=yahoo

# Hardware section inside host (eBay Browse)
# SOPHON_HARDWARE_QUERIES=RTX 5090,RTX 4090,RTX 3090 Ti,A100,Ryzen 9 7950X
# SOPHON_EBAY_CLIENT_ID=
# SOPHON_EBAY_CLIENT_SECRET=

# News | papers (left RSS/HN, right arXiv + HF daily)
# SOPHON_NEWS_FEEDS=https://www.tagesschau.de/xml/rss2/,https://www.br.de/nachrichten/rss
# SOPHON_NEWS_HN=1
# SOPHON_NEWS_LIMIT=6
# SOPHON_PAPERS_LIMIT=4
# SOPHON_PAPERS_HF=1
# SOPHON_NEWS_ARXIV_QUERY=all:"sound event detection" OR all:SELD||all:"brain-computer interface" OR cat:q-bio.NC
# SOPHON_NEWS_ARXIV_CAT=

# Polymarket (Gamma API, keyless). Empty markets = top by 24h volume.
# SOPHON_POLYMARKET_MARKETS=
# SOPHON_POLYMARKET_LIMIT=5

# Twitch Helix (app credentials). Profile label is display-only.
# Create an application at https://dev.twitch.tv/console
# SOPHON_TWITCH_CLIENT_ID=
# SOPHON_TWITCH_CLIENT_SECRET=
# SOPHON_TWITCH_PROFILE=home
# SOPHON_TWITCH_MODE=top
# SOPHON_TWITCH_LIMIT=8
# SOPHON_TWITCH_LANGUAGE=en
# SOPHON_TWITCH_GAME=
# SOPHON_TWITCH_CHANNELS=shroud,xqc

# Google (Gmail readonly + Drive readonly + Custom Search + Chrome bookmark export)
# Create a Desktop OAuth client JSON. Keep the project in Testing and add your emails as test users.
# SOPHON_GOOGLE_CLIENT_SECRETS=C:\path\to\client_secret.json
# SOPHON_GOOGLE_TOOLS=1
# SOPHON_BOOKMARKS_PATH=C:\Notes\Obsidian Notes\KB\Data\Private Data\Chrome\Bookmark Exports
# Custom Search JSON API (separate from OAuth): API key + Programmable Search Engine id (cx)
# SOPHON_GOOGLE_CSE_KEY=
# SOPHON_GOOGLE_CSE_CX=
# SOPHON_WEB_SEARCH_TOOLS=1
# Unset or 1 lists web_search. Set 0 to hide it. Verticals need no key.
# SOPHON_SEARCH_CONTACT=you@example.com
# mailto for Crossref, OpenAlex, PubMed polite pool. Empty still calls the APIs.
# SOPHON_SEARCH_DISABLED=
# Comma list of source names to hide from web_search. /search disable NAME also sets this.
# web_search source= auto (SearXNG then CSE), wikipedia, wikidata, ddg,
# arxiv, crossref, openalex, pubmed, europepmc, semanticscholar, zenodo,
# github, huggingface, stackexchange, hn, mdn, searxng, cse
# SearXNG metasearch (preferred for web_search source=auto when set). JSON must be enabled on the instance.
# docker compose -f scripts/searxng/docker-compose.yml up -d
# SOPHON_SEARXNG_URL=http://127.0.0.1:8888
# SOPHON_SEARXNG_ENGINES=
# SOPHON_SEARXNG_CATEGORIES=general
