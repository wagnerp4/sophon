# Copy to .env and fill in. Never commit real secrets.

HF_TOKEN=
OLLAMA_HOST=http://127.0.0.1:11434

# Chat backends: auto = Ollama if reachable, else LM Studio, else HF presets
ORODRUIN_CHAT_BACKEND=auto
ORODRUIN_LM_STUDIO_HOST=http://127.0.0.1:1234/v1
# ORODRUIN_LM_STUDIO_API_KEY=
# ORODRUIN_LM_STUDIO_TIMEOUT_S=600

# TTS (default: Pipecat Kokoro local). Install: uv sync --extra tts
ORODRUIN_TTS_BACKEND=pipecat
ORODRUIN_TTS_SPEAKER=am_adam
ORODRUIN_TTS_LANGUAGE=English
# ORODRUIN_TTS_SPEED=1.25
# ORODRUIN_TTS_TOOL=1
# ORODRUIN_TTS_BACKEND=hf_qwen_custom_voice
# ORODRUIN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-0.6B-CustomVoice

# SST / mic (Qwen ASR). Install: uv sync --extra sst
# ORODRUIN_SST=1
# ORODRUIN_SST_TOOL=1
# ORODRUIN_SST_BACKEND=hf_qwen
# ORODRUIN_SST_MODEL=Qwen/Qwen3-ASR-0.6B
# ORODRUIN_SST_LANGUAGE=English
# ORODRUIN_SST_LISTEN_S=30
# ORODRUIN_SST_VAD_RMS=0.012
# ORODRUIN_SST_MIC=

# Obsidian vault tools (LM Studio chat tool loop via Local REST API plugin)
# ORODRUIN_OBSIDIAN_TOOLS=1
# ORODRUIN_OBSIDIAN_API_URL=https://127.0.0.1:27124
# ORODRUIN_OBSIDIAN_API_KEY=

# Local shell tools in chat (with vault tools when both env flags are on). PowerShell on Windows.
# ORODRUIN_SHELL_TOOLS=1
# ORODRUIN_SHELL_TIMEOUT_S=60
# Tool-loop rounds (default unlimited). Set 6 to restore the old cap. Chat: /tool-rounds N | /unlimited
# ORODRUIN_TOOL_MAX_ROUNDS=unlimited

# Dashboard layout (2-col grid; system/markets/news/twitch span full width when registered)
ORODRUIN_DASHBOARD_TILES=host,weather,services,storage,system,markets,news,polymarket,twitch
# Optional: semicolon-separated roots for storage tile filetype sample (default: repo root)
# ORODRUIN_SYSTEM_FILETYPE_ROOTS=C:\Software\Python\NLP\Personal\orodruin;H:\data

# Weather (Open-Meteo). Leave empty for IP auto-detect.
# ORODRUIN_WEATHER_QUERY=Munich
# ORODRUIN_WEATHER_LAT=48.137
# ORODRUIN_WEATHER_LON=11.576
# ORODRUIN_WEATHER_TZ=Europe/Berlin
# ORODRUIN_WEATHER_AQI=1

# Markets (crypto + metals + equities/ETFs)
ORODRUIN_CRYPTO_SYMBOLS=BTC,ETH,SOL
ORODRUIN_CRYPTO_PROVIDER=kraken
ORODRUIN_METALS_SYMBOLS=GC=F,SI=F
ORODRUIN_QUOTES_SYMBOLS=AAPL,MSFT,NVDA,GOOGL,AMZN,META,SPY,QQQ
ORODRUIN_QUOTES_PROVIDER=yahoo

# Hardware section inside host (eBay Browse)
# ORODRUIN_HARDWARE_QUERIES=RTX 5090,RTX 4090,RTX 3090 Ti,A100,Ryzen 9 7950X
# ORODRUIN_EBAY_CLIENT_ID=
# ORODRUIN_EBAY_CLIENT_SECRET=

# News | papers (left RSS/HN, right arXiv + HF daily)
# ORODRUIN_NEWS_FEEDS=https://www.tagesschau.de/xml/rss2/,https://www.br.de/nachrichten/rss
# ORODRUIN_NEWS_HN=1
# ORODRUIN_NEWS_LIMIT=6
# ORODRUIN_PAPERS_LIMIT=4
# ORODRUIN_PAPERS_HF=1
# ORODRUIN_NEWS_ARXIV_QUERY=all:"sound event detection" OR all:SELD||all:"brain-computer interface" OR cat:q-bio.NC
# ORODRUIN_NEWS_ARXIV_CAT=

# Polymarket (Gamma API, keyless). Empty markets = top by 24h volume.
# ORODRUIN_POLYMARKET_MARKETS=
# ORODRUIN_POLYMARKET_LIMIT=5

# Twitch Helix (app credentials). Profile label is display-only.
# Create an application at https://dev.twitch.tv/console
# ORODRUIN_TWITCH_CLIENT_ID=
# ORODRUIN_TWITCH_CLIENT_SECRET=
# ORODRUIN_TWITCH_PROFILE=home
# ORODRUIN_TWITCH_MODE=top
# ORODRUIN_TWITCH_LIMIT=8
# ORODRUIN_TWITCH_LANGUAGE=en
# ORODRUIN_TWITCH_GAME=
# ORODRUIN_TWITCH_CHANNELS=shroud,xqc
